# Database (Neon/Postgres in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Red Tara Sanctuary"

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Optional booking notification email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="redtarahouse@gmail.com"

# Protects calendar sync cron (Vercel sets Authorization: Bearer CRON_SECRET)
CRON_SECRET="replace-with-random-cron-secret"
